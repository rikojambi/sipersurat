# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# OAuth scopes (jangan diubah kecuali Google Cloud mengharuskan)
VITE_GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file

# Opsional: API Key dengan HTTP referrer restriction untuk Google Drive Picker.
# API key BUKAN secret, tetapi wajib dibatasi pada domain aplikasi Anda.
VITE_GOOGLE_PICKER_API_KEY=

# Pepper HMAC untuk kode aktivasi mandiri (wajib sama pada semua perangkat).
# Gunakan nilai unik panjang di produksi; perubahan nilai ini membatalkan kode lama.
VITE_ACTIVATION_PEPPER=ganti-dengan-nilai-unik-anda-xxxxx

# Identitas aplikasi
VITE_APP_NAME=SIPERSURAT
VITE_SCHOOL_CODE=SMKN6-MJ
VITE_APP_URL=https://sipersurat.netlify.app
